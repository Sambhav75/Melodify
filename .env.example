# ------------------------------------------------------------------
# Melodify environment variables
# Copy this file to .env.local and fill in the values.
# ------------------------------------------------------------------

# Supabase -> Project Settings -> API
# The project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The public "anon" key (or the newer "publishable" key). Safe to expose in the browser
# because Row Level Security protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPTIONAL - server only. Needed just for the "Delete user" button in the admin area.
# Use the "service_role" (or "secret") key. NEVER prefix it with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL - set to true to skip Next.js image optimisation (useful if you hit the
# Vercel Hobby image-optimisation quota). Covers are then loaded straight from Supabase.
NEXT_PUBLIC_DISABLE_IMAGE_OPTIMIZATION=false
